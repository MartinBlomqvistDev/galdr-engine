# GALDR Engine – BYOK Configuration
# Kopiera till .env och fyll i dina nycklar

# LLM (Bring Your Own Key)
OPENAI_API_KEY=sk-...

# Valfri: Anthropic som alternativ
ANTHROPIC_API_KEY=sk-ant-...

# Redis (session cache)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (persistent state)
DATABASE_URL=postgresql+asyncpg://galdr:galdr@localhost:5432/galdr

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Voice
TTS_MODEL_PATH=./models/galdr_voice
STT_MODEL=whisper-1
